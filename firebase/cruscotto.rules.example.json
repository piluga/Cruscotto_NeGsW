{
  "rules": {
    ".read": false,
    ".write": false,
    "accessi": { ".read": false, ".write": false },
    "vendite_live": {
      ".read": "auth != null && root.child('accessi/cruscotto').child(auth.uid).val() === true",
      ".write": false
    },
    "storico_vendite": {
      ".read": "auth != null && root.child('accessi/cruscotto').child(auth.uid).val() === true",
      ".write": false,
      ".indexOn": ["GIORNO"]
    },
    "storico_movimenti": {
      ".read": "auth != null && root.child('accessi/cruscotto').child(auth.uid).val() === true",
      ".write": false,
      ".indexOn": ["data"]
    }
  }
}
